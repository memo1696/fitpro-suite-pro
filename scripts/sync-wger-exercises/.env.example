# Copia este archivo como .env en esta misma carpeta (scripts/sync-wger-exercises/.env)
# y rellena los valores. NUNCA subas el .env real a git (ya debería estar en .gitignore
# por el patrón "*.env" / ".env" que normalmente incluye Nuevo APP; verifícalo).

# URL del proyecto de Supabase que REALMENTE usa la app en producción.
# OJO: el .env.example de la raíz del proyecto tiene una URL vieja/distinta
# (rshpzqppvciujwtuzniv) — esa ya no es la que usa la app. La correcta es
# la que aparece en vercel.json (Content-Security-Policy), confirmada así:
SUPABASE_URL="https://uktxhaeksmtwwsxljehb.supabase.co"

# Service Role Key (¡SECRETA! del MISMO proyecto de arriba —
# Dashboard > (asegúrate de estar en el proyecto uktxhaeksmtwwsxljehb) >
# Project Settings > API Keys > pestaña "Legacy API Keys" > service_role)
# Esta clave se salta las políticas RLS, así que solo se usa aquí, en un script que
# corres tú mismo en tu máquina. Jamás debe llegar al frontend ni a un commit.
SUPABASE_SERVICE_ROLE_KEY=""

# Nombre del bucket de Supabase Storage donde se guardará todo (se crea solo si no existe)
SUPABASE_BUCKET="exercise-media"

# Idioma preferido para los nombres/descripciones (código corto de wger, ej: "es", "en")
WGER_LANGUAGE_CODE="es"
WGER_LANGUAGE_FALLBACK_CODE="en"

# Límite de ejercicios a procesar por corrida (déjalo vacío para procesar todos)
WGER_LIMIT=""
